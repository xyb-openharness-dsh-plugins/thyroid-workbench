{
  "name": "@xyb-community/thyroid-workbench",
  "version": "0.2.5",
  "description": "面向甲状腺癌患者与照护者的本机病程资料、病理与 ATA 分层档案（只引用不判定）、碘131 治疗档案、TSH 抑制剂量时间线、颈部超声并列与终生随访工作台设计项目",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "public",
    "src",
    "demo/build-demo-data.mjs",
    "demo/seed-demo-sqlite.mjs",
    "schema",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "THY_CHANNEL=beta node scripts/build-version.mjs && node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs && node scripts/build-client.mjs --check && node scripts/check-version.mjs && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-demo-columns.mjs && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-workbench-package.mjs . && node scripts/check-primer-links.mjs && node scripts/check-agent-pane-contract.mjs .",
    "audit": "node scripts/check-conformance.mjs .",
    "build:version": "THY_CHANNEL=beta node scripts/build-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "release:check": "npm run check && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "probe:proto": "node scripts/probe-proto.mjs",
    "check:hvt": "node scripts/check-hvt.mjs",
    "demo:data": "node demo/build-demo-data.mjs",
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:columns": "node scripts/check-demo-columns.mjs",
    "check:install": "node scripts/check-install.mjs",
    "check:pack": "node --disable-warning=ExperimentalWarning scripts/check-pack.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "start": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "probe:headless": "node --disable-warning=ExperimentalWarning scripts/probe-headless.mjs",
    "probe:install": "node scripts/probe-install.mjs",
    "probe:primer": "node scripts/probe-disease-primer.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/thyroid-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
