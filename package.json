{
  "name": "@xyb-community/thyroid-workbench",
  "version": "0.1.0",
  "description": "面向甲状腺癌患者与照护者的本机病程资料、复发风险分层档案、TSH 抑制管理、碘131 治疗档案、颈部超声年度线与终生随访工作台设计项目",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/check-workbench-package.mjs .",
    "audit": "node scripts/check-conformance.mjs .",
    "release:check": "npm run check && npm run audit",
    "pack:check": "npm pack --dry-run",
    "probe:proto": "node scripts/probe-proto.mjs",
    "probe:resp": "node scripts/probe-responsive.mjs",
    "demo:build": "node demo/build-demo-data.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/thyroid-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
